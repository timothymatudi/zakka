# Copy to .env and fill in. Every integration runs in mock mode when its keys are empty.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Internal services
SEARCH_API_URL=http://localhost:4010
SEARCH_ADMIN_TOKEN=
# Countries that get precomputed price/speed/score fields (comma-separated ISO codes; empty = DB countries.is_active)
SEARCH_ACTIVE_COUNTRIES=
# Merge live partner-store results into search (1 = on, 0 = off)
SEARCH_LIVE_AFFILIATES=1
# Shared dev dataset written by `python -m zakka_catalog export-dev`
DEV_CATALOG_PATH=../../packages/fixtures/dev-catalog.json
# Hourly product refresh (catalog scheduler)
SYNC_INTERVAL_MINUTES=60
CATALOG_API_URL=http://localhost:4020
# Shared secret for service-to-service calls to the catalog API (sent as Authorization: Bearer)
CATALOG_API_TOKEN=
CONCIERGE_PORT=4030
# Public base URL for the WhatsApp webhook and payment links
CONCIERGE_PUBLIC_URL=http://localhost:4030
# Protects /internal/* on the concierge (sent as x-internal-token)
CONCIERGE_INTERNAL_TOKEN=
WEB_BASE_URL=http://localhost:3000
# WhatsApp number for wa.me links (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Search (Typesense)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# AI (search understanding, translation, concierge)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Dropship suppliers
# CJ API key (CJ dashboard > API). Sandbox orders are not charged.
CJ_API_KEY=
CJ_SANDBOX=
# Warehouse country CJ orders ship from (default CN)
CJ_FROM_COUNTRY=
ALIEXPRESS_DS_APP_KEY=
ALIEXPRESS_DS_APP_SECRET=
ALIEXPRESS_DS_ACCESS_TOKEN=
SPOCKET_API_KEY=
PRINTFUL_API_TOKEN=
# Only for account-level Printful tokens
PRINTFUL_STORE_ID=

# Affiliate partners
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAGS=US:zakka-20,AE:zakka-21,SA:zakka-21,IN:zakka-21,EG:zakka-21
TEMU_AFFILIATE_ID=
SHEIN_AFFILIATE_ID=
ALIEXPRESS_AFF_APP_KEY=
ALIEXPRESS_AFF_APP_SECRET=
ALIEXPRESS_AFF_TRACKING_ID=
JUMIA_AFFILIATE_ID=
NOON_AFFILIATE_ID=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Worldwide sources. Each runs in mock mode until all of its keys are set.
# eBay Browse API (developer.ebay.com keyset) + eBay Partner Network campaign id
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
# Optional: affiliateReferenceId, eBay sites to import, and seed queries for the import
EBAY_REFERENCE_ID=
EBAY_MARKETPLACES=EBAY_US,EBAY_GB,EBAY_DE,EBAY_AU,EBAY_CA,EBAY_FR
EBAY_SEED_QUERIES=
# Awin: publisher id + data feed key (Create-a-Feed link, NOT the Publisher API key)
AWIN_PUBLISHER_ID=
AWIN_FEED_KEY=
# Impact: Account SID + Auth Token (Settings > API); countries the catalogs ship to
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_COUNTRIES=US
# Rakuten Advertising Product Search (Bearer token from the developer portal)
RAKUTEN_ADV_TOKEN=
RAKUTEN_ADV_MIDS=
RAKUTEN_COUNTRIES=US
RAKUTEN_SEED_QUERIES=
# Admitad: OAuth client + ad space (website) id
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=
MPESA_ENV=sandbox

# FX rates
FX_API_URL=

