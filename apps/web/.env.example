# Copy to .env.local. Every value may be left empty: the storefront then runs in mock mode.
SEARCH_API_URL=http://localhost:4010
CATALOG_API_URL=http://localhost:4020
CATALOG_API_TOKEN=
WEB_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# WhatsApp number in international format, digits only (used for the wa.me link). Contract request: add to root .env.example.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Payments (all mock until set)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
# Contract request: M-Pesa (Daraja) keys are not in the root .env.example yet.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Set to 1 to force mock data even when the service URLs are set.
ZAKKA_FORCE_MOCK=
