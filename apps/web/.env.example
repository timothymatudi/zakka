# Copy to .env.local. Every value may be left empty: the storefront then runs in mock mode.
SEARCH_API_URL=http://localhost:4010
CATALOG_API_URL=http://localhost:4020
CATALOG_API_TOKEN=
WEB_BASE_URL=http://localhost:3000
# Payments are created by the concierge service. Empty: instant mock payment in development only;
# a production build refuses checkout. Unreachable: checkout fails, the order is never marked paid.
CONCIERGE_PUBLIC_URL=http://localhost:4030
CONCIERGE_INTERNAL_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Sign-in (email one-time code) also needs the anon key. Empty: mock sign-in in development, off in production.
# Admins are Supabase users with app_metadata.role = "admin".
SUPABASE_ANON_KEY=
# WhatsApp number in international format, digits only (used for the wa.me link). Contract request: add to root .env.example.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Set to 1 to force mock data even when the service URLs are set.
ZAKKA_FORCE_MOCK=
