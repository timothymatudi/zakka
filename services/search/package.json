{
  "name": "@zakka/search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zakka search service: Typesense indexing, query understanding, ranking and the /search HTTP API.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "index": "tsx src/cli/index.ts",
    "schema": "tsx src/cli/schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx src/cli/bench.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typesense": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
